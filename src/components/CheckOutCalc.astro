---

---

<section class="mt-4">
    <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-8">

        <div>
            <h2 class="text-xl font-bold">Hora de salida</h2>
            <p class="text-sm text-zinc-400 mt-1">Calcula tu hora de salida</p>
        </div>

        
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
                <label for="calc-time" class="text-sm text-zinc-400">Hora de entrada</label>
                <input 
                    type="time" 
                    id="calc-time" 
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500 [color-scheme:dark]"
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="calc-hours" class="text-sm text-zinc-400">Horas de jornada</label>
                <select
                    id="calc-hours"
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500"
                >
                    {
                        Array.from({ length: 12 }, (_, i) => i + 1).map((num) => (
                            <option value={num} selected={num === 4}>
                                {num} {num === 1 ? 'hora' : 'horas'}
                            </option>
                        ))
                    }
                </select>
            </div>
        </div>


        <button
            id="calc-check-out-btn"
            class="w-full rounded-lg bg-white px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200"
        >
            Calcular
        </button>
           
        <div class="rounded-lg border border-zinc-800 bg-zinc-950/50 p-4 text-center">
            <p class="text-sm text-zinc-400">Hora de salida</p>
            <span id="calc-result" class="text-6xl font-bold font-mono">
                --:--
            </span>
        </div>

    </div>
</section>

<script>
    import { getClockOutTime } from "../lib/shifts.js";

    const timeInput = document.querySelector("#calc-time") as HTMLInputElement;
    const hoursSelect = document.querySelector("#calc-hours") as HTMLSelectElement;
    const resultDisplay = document.querySelector("#calc-result");
    const calcCheckOutBtn = document.querySelector("#calc-check-out-btn");

    const calcCheckOut = () => {
        const timeValue = timeInput?.value;
        const hoursValue = Number(hoursSelect?.value);

        if (timeValue && hoursValue && resultDisplay) {
            resultDisplay.textContent = getClockOutTime(timeValue, hoursValue);
        } else if (resultDisplay) {
            resultDisplay.textContent = "--:--";
        }
    };

    calcCheckOutBtn?.addEventListener("click", calcCheckOut);
</script>