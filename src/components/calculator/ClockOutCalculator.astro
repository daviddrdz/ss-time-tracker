---
import Button from "@/components/ui/Button.astro";
import Field from "@/components/ui/Field.astro";
import Input from "@/components/ui/Input.astro";
import HoursSelect from "@/components/ui/HoursSelect.astro";
---

<section class="mt-4">
    <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-8">

        <div>
            <h2 class="text-xl font-bold">Hora de salida</h2>
            <p class="text-sm text-zinc-400 mt-1">Calcula tu hora de salida</p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <Field label="Hora de entrada" labelFor="start-time-input">
                <Input type="time" id="start-time-input" />
            </Field>

            <Field label="Horas de jornada" labelFor="shift-hours-select">
                <HoursSelect id="shift-hours-select" />
            </Field>
        </div>

        <Button id="calculate-clock-out-button" class="w-full">Calcular</Button>

        <div class="rounded-lg border border-zinc-800 bg-zinc-950/50 p-4 text-center">
            <p class="text-sm text-zinc-400">Hora de salida</p>
            <span id="clock-out-display" class="text-6xl font-bold font-mono">--:--</span>
        </div>

    </div>
</section>

<script>
    import { getClockOutTime } from "@/lib/shifts";
    import { getSettings } from "@/config/settings";
    import { $ } from "@/lib/dom";

    const startTimeInput = $<HTMLInputElement>("#start-time-input");
    const shiftHoursSelect = $<HTMLSelectElement>("#shift-hours-select");
    const clockOutDisplay = $<HTMLSpanElement>("#clock-out-display");
    const calculateClockOutButton = $<HTMLButtonElement>("#calculate-clock-out-button");

    shiftHoursSelect.value = String(getSettings().defaultShiftHours);

    calculateClockOutButton.addEventListener("click", () => {
        const startTime = startTimeInput.value;
        const shiftHours = Number(shiftHoursSelect.value);

        clockOutDisplay.textContent = startTime && shiftHours ? getClockOutTime(startTime, shiftHours) : "--:--";
    });
</script>

