---
---

<section class="mt-8">
    <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-8">
        
        <div>
            <h2 class="text-xl font-bold">Proyección de término</h2>
            <p class="text-sm text-zinc-400 mt-1">Calcula cuánto tiempo te tomará terminar</p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
                <label for="completed-hours-input" class="text-sm text-zinc-400">Horas realizadas</label>
                <input 
                    type="number" 
                    id="completed-hours-input" 
                    placeholder="Ej. 120"
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>
            
            <div class="flex flex-col gap-2">
                <label for="total-hours-input" class="text-sm text-zinc-400">Total de horas a cumplir</label>
                <input 
                    type="number" 
                    id="total-hours-input" 
                    placeholder="Ej. 480"
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>
            
            <div class="flex flex-col gap-2">
                <label for="hours-per-day-input" class="text-sm text-zinc-400">Horas por turno (al día)</label>
                <input 
                    type="number" 
                    id="hours-per-day-input" 
                    placeholder="Ej. 4"
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>
            
            <div class="flex flex-col gap-2">
                <label for="days-per-week-input" class="text-sm text-zinc-400">Días de asistencia a la semana</label>
                <input 
                    type="number" 
                    id="days-per-week-input" 
                    placeholder="Ej. 5"
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <label for="projection-format-select" class="text-sm text-zinc-400">Formato de vista</label>
            <select id="projection-format-select" class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white outline-none focus:border-zinc-500">
                <option value="detailed">Todo junto (Meses, Semanas, Días)</option>
                <option value="days">Solo días</option>
                <option value="weeks">Solo semanas</option>
                <option value="months">Solo meses</option>
            </select>
        </div>

        <button
            type="button"
            id="calculate-projection-button"
            class="w-full rounded-lg bg-white px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200"
        >
            Calcular
        </button>

        <div class="rounded-lg border border-zinc-800 bg-zinc-950/50 p-4 text-center">
            <span id="projection-display" class="text-2xl font-bold text-white">--</span>
        </div>


    </div>
</section>

<script>
    import { $ } from "@/lib/dom";
    import { formatProjection, type ProjectionFormat } from "@/lib/projection";

    const completedHoursInput = $<HTMLInputElement>("#completed-hours-input");
    const totalHoursInput = $<HTMLInputElement>("#total-hours-input");
    const hoursPerDayInput = $<HTMLInputElement>("#hours-per-day-input");
    const daysPerWeekInput = $<HTMLInputElement>("#days-per-week-input");
    const projectionFormatSelect = $<HTMLSelectElement>("#projection-format-select");
    const projectionDisplay = $<HTMLSpanElement>("#projection-display");
    const calculateProjectionButton = $<HTMLButtonElement>("#calculate-projection-button");

    const calculateProjection = () => {
        const completedHours = Number(completedHoursInput.value);
        const totalHours = Number(totalHoursInput.value);
        const hoursPerDay = Number(hoursPerDayInput.value);
        const daysPerWeek = Number(daysPerWeekInput.value);
        const format = projectionFormatSelect.value as ProjectionFormat;

        if (totalHours > 0 && hoursPerDay > 0 && daysPerWeek > 0 && completedHours >= 0) {
            const remainingHours = Math.max(0, totalHours - completedHours);
            projectionDisplay.textContent = formatProjection(remainingHours, hoursPerDay, daysPerWeek, format);
        } else {
            projectionDisplay.textContent = "--";
        }
    };

    calculateProjectionButton.addEventListener("click", calculateProjection);
</script>

