---
import Field from "@/components/ui/Field.astro";
import Input from "@/components/ui/Input.astro";
import ProjectionFormatSelect from "@/components/ui/ProjectionFormatSelect.astro";
import DaysSelect from "@/components/ui/DaysSelect.astro";
import HoursSelect from "@/components/ui/HoursSelect.astro";
import Button from "@/components/ui/Button.astro";
---

<section class="mt-8">
    <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-8">

        <div>
            <h2 class="text-xl font-bold">Proyección de término</h2>
            <p class="text-sm text-zinc-400 mt-1">Calcula cuánto tiempo te tomará terminar</p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <Field label="Horas realizadas" labelFor="completed-hours-input">
                <Input id="completed-hours-input" type="number" placeholder="Ej. 120" min="0" />
            </Field>

            <Field label="Total de horas a cumplir" labelFor="total-hours-input">
                <Input type="number" id="total-hours-input" placeholder="Ej. 480" min="0" />
            </Field>

            <Field label="Horas por turno (al día)" labelFor="hours-per-day-select">
                <HoursSelect id="hours-per-day-select" />
            </Field>

            <Field label="Días de asistencia a la semana" labelFor="days-per-week-select">
                <DaysSelect id="days-per-week-select" />
            </Field>
        </div>

        <Field label="Formato de vista" labelFor="projection-format-select">
            <ProjectionFormatSelect id="projection-format-select" />
        </Field>

        <Button id="calculate-projection-button" class="w-full">
            Calcular
        </Button>

        <div class="rounded-lg border border-zinc-800 bg-zinc-950/50 p-4 text-center">
            <span id="projection-display" class="text-2xl font-bold text-white">--</span>
        </div>
    </div>
</section>

<script>
    import { $ } from "@/lib/dom";
    import { formatProjection, type ProjectionFormat } from "@/lib/projection";

    const completedHoursInput = $<HTMLInputElement>("#completed-hours-input");
    const totalHoursInput = $<HTMLInputElement>("#total-hours-input");
    const hoursPerDaySelect = $<HTMLInputElement>("#hours-per-day-select");
    const daysPerWeekSelect = $<HTMLInputElement>("#days-per-week-select");
    const projectionFormatSelect = $<HTMLSelectElement>("#projection-format-select");
    const projectionDisplay = $<HTMLSpanElement>("#projection-display");
    const calculateProjectionButton = $<HTMLButtonElement>("#calculate-projection-button");

    const calculateProjection = () => {
        const completedHours = Number(completedHoursInput.value);
        const totalHours = Number(totalHoursInput.value);
        const hoursPerDay = Number(hoursPerDaySelect.value);
        const daysPerWeek = Number(daysPerWeekSelect.value);
        const format = projectionFormatSelect.value as ProjectionFormat;

        if (totalHours > 0 && hoursPerDay > 0 && daysPerWeek > 0 && completedHours >= 0) {
            const remainingHours = Math.max(0, totalHours - completedHours);
            projectionDisplay.textContent = formatProjection(remainingHours, hoursPerDay, daysPerWeek, format);
        } else {
            projectionDisplay.textContent = "--";
        }
    };

    calculateProjectionButton.addEventListener("click", calculateProjection);
</script>

