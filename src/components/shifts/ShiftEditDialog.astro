---
import Field from "@/components/ui/Field.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";
---

<dialog id="edit-dialog" class="m-auto w-[90%] max-w-sm rounded-xl border border-zinc-800 bg-zinc-900 p-0 text-white shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm">
    <form id="edit-form" method="dialog" class="p-6 space-y-4">
        <h3 class="text-xl font-bold">Detalles del turno</h3>

        <input type="hidden" id="edit-id-input" />

        <Field label="Fecha" labelFor="edit-date-input">
            <Input type="date" id="edit-date-input" required />
        </Field>

        <Field label="Hora de entrada" labelFor="edit-start-input">
            <Input type="time" id="edit-start-input" required />
        </Field>

        <Field label="Hora de salida" labelFor="edit-end-input" hint="Borra la hora si el turno sigue en curso.">
            <Input type="time" id="edit-end-input" />
        </Field>

        <div class="mt-6 flex flex-col gap-3">
            <div class="flex gap-3">
                <Button type="submit" value="cancel" formnovalidate variant="secondary" class="flex-1">
                    Cerrar
                </Button>
                <Button type="submit" value="save" variant="primary" class="flex-1">
                    Guardar
                </Button>
            </div>
            <Button id="delete-shift-button" variant="danger" class="w-full">
                Eliminar turno
            </Button>
        </div>
    </form>
</dialog>

