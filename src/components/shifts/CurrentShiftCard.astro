---
import Field from "@/components/ui/Field.astro";
import HoursSelect from "@/components/ui/HoursSelect.astro";
import Button from "@/components/ui/Button.astro";
---

<section class="mt-4">
    <h2 class="mb-3 text-xl font-bold">Turno de hoy</h2>

    <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-6">

        <div class="grid grid-cols-2 gap-4">

            <Field label="Horas de jornada" labelFor="shift-hours-select">
                <HoursSelect id="shift-hours-select" />
            </Field>

            <div class="flex flex-col gap-2">
                <span class="text-sm text-zinc-400">Tiempo restante</span>
                <div class="flex h-10 w-full items-center justify-center rounded-lg border 
                            border-zinc-700 bg-zinc-800 px-3 py-2 text-white">
                    <span id="time-remaining-display" class="font-mono text-base font-medium tracking-wide">
                        00:00
                    </span>
                </div>
            </div>

        </div>

        <div class="rounded-lg border border-zinc-800 bg-zinc-950/50 p-4 text-center">
            <p class="text-sm text-zinc-400">Hora de salida</p>
                <span id="clock-out-display" class="text-6xl font-bold font-mono">
                --:--
            </span>
        </div>

        <Button id="register-button" class="w-full">Registrar entrada</Button>
    </div>

</section>

<script>
    import type { Shift } from "@/types/shift";
    import { getSettings } from "@/config/settings";
    import { getClockOutTime, getActiveShift } from "@/lib/shifts";
    import { loadShifts, saveShifts, SHIFT_UPDATED_EVENT } from "@/lib/storage";
    import { $ } from "@/lib/dom";

    const MS_PER_MINUTE = 60_000;

    const clockOutDisplay = $<HTMLSpanElement>("#clock-out-display");
    const shiftHoursSelect = $<HTMLSelectElement>("#shift-hours-select");
    const registerButton = $<HTMLButtonElement>("#register-button");
    const timeRemainingDisplay = $<HTMLSpanElement>("#time-remaining-display");

    const getRemainingText = (shift: Shift, plannedHours: number): string => {
        const [year, month, day] = shift.date.split("-").map(Number);
        const [startHour] = shift.start.split(":").map(Number);
        const [endHour, endMinute] = getClockOutTime(shift.start, plannedHours).split(":").map(Number);

        let endTime = new Date(year, month - 1, day, endHour, endMinute).getTime();
        if (endHour < startHour) endTime += 24 * 60 * MS_PER_MINUTE;

        const remainingMinutes = Math.max(0, Math.floor((endTime - Date.now()) / MS_PER_MINUTE));
        const hours = String(Math.floor(remainingMinutes / 60)).padStart(2, "0");
        const minutes = String(remainingMinutes % 60).padStart(2, "0");

        return `${hours}:${minutes}`;
    };

    const render = () => {
        const activeShift = getActiveShift(loadShifts());

        if (!activeShift) {
            registerButton.textContent = "Registrar entrada";
            clockOutDisplay.textContent = "--:--";
            timeRemainingDisplay.textContent = "00:00";
            return;
        }

        const plannedHours = activeShift.plannedHours ?? Number(shiftHoursSelect.value);

        registerButton.textContent = "Registrar salida";
        clockOutDisplay.textContent = getClockOutTime(activeShift.start, plannedHours);
        timeRemainingDisplay.textContent = getRemainingText(activeShift, plannedHours);
    };

    shiftHoursSelect.value = String(
        getActiveShift(loadShifts())?.plannedHours ?? getSettings().SHIFT_HRS
    );

    registerButton.addEventListener("click", () => {
        const now = new Date();
        const date = [
            now.getFullYear(),
            String(now.getMonth() + 1).padStart(2, "0"),
            String(now.getDate()).padStart(2, "0")
        ].join("-");
        const time = [
            String(now.getHours()).padStart(2, "0"),
            String(now.getMinutes()).padStart(2, "0")
        ].join(":");

        const shifts = loadShifts();
        const activeShift = getActiveShift(shifts);

        if (activeShift) {
            activeShift.end = time;
        } else {
            shifts.push({
                id: Date.now().toString(),
                date,
                start: time,
                end: null,
                plannedHours: Number(shiftHoursSelect.value),
            });
        }

        saveShifts(shifts);
    });

    shiftHoursSelect.addEventListener("change", () => {
        const shifts = loadShifts();
        const activeShift = getActiveShift(shifts);
        if (!activeShift) return;

        activeShift.plannedHours = Number(shiftHoursSelect.value);
        saveShifts(shifts);
    });

    window.addEventListener(SHIFT_UPDATED_EVENT, render);
    setInterval(render, 30_000);
    render();
</script>

