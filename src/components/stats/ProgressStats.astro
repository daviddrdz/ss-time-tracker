---
import Field from "@/components/ui/Field.astro";
import HoursSelect from "@/components/ui/HoursSelect.astro";
import ProjectionFormatSelect from "@/components/ui/ProjectionFormatSelect.astro";
import DaysSelect from "@/components/ui/DaysSelect.astro";
---

<section class="mt-4">
    <h2 class="mb-3 text-xl font-bold">Estadísticas</h2>

    <div class="mb-4 grid grid-cols-2 gap-4">
        <div class="text-center rounded-xl border border-zinc-800 bg-zinc-900 p-6">
            <p class="text-sm text-zinc-400">Realizadas</p>
            <span id="completed-hours-display" class="text-4xl font-bold font-mono"></span>
        </div>

        <div class="text-center rounded-xl border border-zinc-800 bg-zinc-900 p-6">
            <p class="text-sm text-zinc-400">Restantes</p>
            <span id="remaining-hours-display" class="text-4xl font-bold font-mono"></span>
        </div>
    </div>

    <div class="mb-4 rounded-xl border border-zinc-800 bg-zinc-900 p-6 pt-4">
        <div class="mb-3 flex items-center justify-between">
            <span id="goal-hours-display" class="text-base font-medium text-zinc-400"></span>
            <span id="progress-percentage-display" class="text-sm font-bold font-mono text-white">0%</span>
        </div>
        <div class="h-3 w-full overflow-hidden rounded-full bg-zinc-800">
            <div 
                id="progress-bar" 
                class="h-full rounded-full bg-white transition-all duration-700 ease-out" 
                style="width: 0%"
            ></div>
        </div>
    </div>

    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-6">
        <div class="text-center">
            <h3 class="text-xl font-bold text-white">Proyección de término</h3>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <Field label="Horas/día" labelFor="hours-per-day-select">
                <HoursSelect id="hours-per-day-select" />
            </Field>

            <Field label="Días/semana" labelFor="days-per-week-select">
                <DaysSelect id="days-per-week-select" />
            </Field>
        </div>

        <Field label="Formato de vista" labelFor="projection-format-select">
            <ProjectionFormatSelect id="projection-format-select" />
        </Field>

        <div class="rounded-lg border border-zinc-800 bg-zinc-950/50 p-4 text-center">
            <span id="projection-result-display" class="text-2xl font-bold text-white">--</span>
        </div>
    </div>

</section>

<script>
    import { getTotalHours } from "@/lib/shifts";
    import { getSettings, saveSettings } from "@/config/settings";
    import { SHIFT_UPDATED_EVENT } from "@/lib/storage";
    import { formatProjection, type ProjectionFormat } from "@/lib/projection";
    import { $ } from "@/lib/dom";

    const completedHoursDisplay = $<HTMLSpanElement>("#completed-hours-display");
    const remainingHoursDisplay = $<HTMLSpanElement>("#remaining-hours-display");
    const goalHoursDisplay = $<HTMLSpanElement>("#goal-hours-display");
    const progressBar = $<HTMLDivElement>("#progress-bar");
    const progressPercentageDisplay = $<HTMLSpanElement>("#progress-percentage-display");

    const hoursPerDaySelect = $<HTMLSelectElement>("#hours-per-day-select");
    const daysPerWeekSelect = $<HTMLSelectElement>("#days-per-week-select");
    const projectionFormatSelect = $<HTMLSelectElement>("#projection-format-select");
    const projectionResultDisplay = $<HTMLSpanElement>("#projection-result-display");

    const savePreferences = () => {
        saveSettings({
            ...getSettings(),
            SHIFT_HRS: Number(hoursPerDaySelect.value),
            DAYS_PER_WEEK: Number(daysPerWeekSelect.value),
        });
    };


    const updateUI = () => {
        const settings = getSettings();
        const completed = getTotalHours();
        const remaining = Math.max(0, settings.TOTAL_HRS - completed);
        const percentage = Math.min((completed / settings.TOTAL_HRS) * 100, 100);

        completedHoursDisplay.textContent = completed + "h";
        remainingHoursDisplay.textContent = remaining + "h";
        goalHoursDisplay.textContent = `Meta: ${settings.TOTAL_HRS}h`;
        progressBar.style.width = `${percentage}%`;
        progressPercentageDisplay.textContent = `${percentage.toFixed(2)}%`;

        if (remaining <= 0) {
            projectionResultDisplay.textContent = "¡Servicio terminado!";
            return;
        }

        projectionResultDisplay.textContent = formatProjection(
            remaining,
            Number(hoursPerDaySelect.value),
            Number(daysPerWeekSelect.value),
            projectionFormatSelect.value as ProjectionFormat,
        );
    }

    const initialSettings = getSettings();
    hoursPerDaySelect.value = String(initialSettings.SHIFT_HRS);
    daysPerWeekSelect.value = String(initialSettings.DAYS_PER_WEEK);
    updateUI();

    window.addEventListener(SHIFT_UPDATED_EVENT, updateUI);
    projectionFormatSelect.addEventListener("change", updateUI);

    hoursPerDaySelect.addEventListener("change", () => {
        savePreferences();
        updateUI();
    })
    daysPerWeekSelect.addEventListener("change", () => {
        savePreferences();
        updateUI();
    })

</script>

