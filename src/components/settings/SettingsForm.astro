---
import Field from "@/components/ui/Field.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";
import DaysSelect from "@/components/ui/DaysSelect.astro";
import HoursSelect from "@/components/ui/HoursSelect.astro";
---

<section class="mt-4">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-6">
        
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <Field label="Total de horas del servicio social" labelFor="total-hours-input">
                <Input type="number" id="total-hours-input" />
            </Field>

            <Field label="Horas previamente realizadas" labelFor="initial-hours-input">
                <Input type="number" id="initial-hours-input" />
            </Field>

            <Field label="Minutos mínimos para redondear a hora" labelFor="min-minutes-to-round-input">
                <Input type="number" id="min-minutes-to-round-input" min="0" max="60" />
            </Field>

            <Field label="Horas por defecto de la jornada" labelFor="default-shift-hours-select">
                <HoursSelect id="default-shift-hours-select" />
            </Field>

            <Field label="Días de asistencia por semana" labelFor="days-per-week-select">
                <DaysSelect id="days-per-week-select" />
            </Field>
        </div>

        <Button id="save-settings-button" class="w-full mt-4">
            Guardar ajustes
        </Button>
    </div>
</section>

<script>
    import { getSettings, saveSettings } from "@/config/settings";
    import { $ } from "@/lib/dom";

    const totalHoursInput = $<HTMLInputElement>("#total-hours-input");
    const initialHoursInput = $<HTMLInputElement>("#initial-hours-input");
    const minMinutesToRoundHourInput = $<HTMLInputElement>("#min-minutes-to-round-input");
    const defaultShiftHoursSelect = $<HTMLInputElement>("#default-shift-hours-select");
    const daysPerWeekSelect = $<HTMLInputElement>("#days-per-week-select");
    const saveSettingsButton = $<HTMLButtonElement>("#save-settings-button");

    const SAVE_LABEL = saveSettingsButton.textContent;

    const fillForm = () => {
        const settings = getSettings();
        totalHoursInput.value = String(settings.totalHours);
        initialHoursInput.value = String(settings.initialHours);
        minMinutesToRoundHourInput.value = String(settings.minMinutesToRound);
        defaultShiftHoursSelect.value = String(settings.defaultShiftHours);
        daysPerWeekSelect.value = String(settings.daysPerWeek);
    };

    fillForm();
    saveSettingsButton.addEventListener("click", () => {
        saveSettings({
            totalHours: Number(totalHoursInput.value),
            initialHours: Number(initialHoursInput.value),
            minMinutesToRound: Number(minMinutesToRoundHourInput.value),
            defaultShiftHours: Number(defaultShiftHoursSelect.value),
            daysPerWeek: Number(daysPerWeekSelect.value)
        });

        saveSettingsButton.textContent = "¡Ajustes guardados!";
        setTimeout(() => {
            saveSettingsButton.textContent = SAVE_LABEL;
        }, 2000);
    });
</script>

