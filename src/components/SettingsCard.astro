---

<section class="mt-4">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6 space-y-6">
        
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <!-- TOTAL_HRS -->
            <div class="flex flex-col gap-2">
                <label for="total-hrs" class="text-sm text-zinc-400">Total de horas del servicio social</label>
                <input 
                    type="number" 
                    id="total-hrs" 
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>

            <!-- INIT_HRS -->
            <div class="flex flex-col gap-2">
                <label for="init-hrs" class="text-sm text-zinc-400">Horas previamente realizadas</label>
                <input 
                    type="number" 
                    id="init-hrs" 
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>

            <!-- MIN_FOR_HR -->
            <div class="flex flex-col gap-2">
                <label for="min-for-hr" class="text-sm text-zinc-400">Minutos mínimos para redondear a hora</label>
                <input 
                    type="number" 
                    id="min-for-hr" 
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>

            <!-- DEFAULT_SHIFT_HRS -->
            <div class="flex flex-col gap-2">
                <label for="default-shift-hrs" class="text-sm text-zinc-400">Horas por defecto de la jornada</label>
                <input 
                    type="number" 
                    id="shift-hrs" 
                    class="h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500" 
                />
            </div>
        </div>

        <button
            id="save-settings"
            class="mt-4 w-full rounded-lg bg-white px-4 py-2 font-medium text-zinc-900 transition-colors hover:bg-zinc-200"
        >
            Guardar ajustes
        </button>

    </div>
</section>

<script>
    import { getSettings, saveSettings } from "../config/settings";

    const totalHrsInput = document.querySelector("#total-hrs") as HTMLInputElement;
    const initHrsInput = document.querySelector("#init-hrs") as HTMLInputElement;
    const minForHrInput = document.querySelector("#min-for-hr") as HTMLInputElement;
    const shiftHrsInput = document.querySelector("#shift-hrs") as HTMLInputElement;
    const saveButton = document.querySelector("#save-settings");

    const loadSettings = () => {
        const settings = getSettings();

        if (totalHrsInput) totalHrsInput.value = settings.TOTAL_HRS;
        if (initHrsInput) initHrsInput.value = settings.INIT_HRS;
        if (minForHrInput) minForHrInput.value = settings.MIN_FOR_HR;
        if (shiftHrsInput) shiftHrsInput.value = settings.SHIFT_HRS;
    }

    loadSettings();

    saveButton?.addEventListener("click", () => {
        const newSettings = {
            TOTAL_HRS: Number(totalHrsInput.value),
            INIT_HRS: Number(initHrsInput.value),
            MIN_FOR_HR: Number(minForHrInput.value),
            SHIFT_HRS: Number(shiftHrsInput.value),
        };

        saveSettings(newSettings);

        const originalText = saveButton.textContent;
        saveButton.textContent = "¡Ajustes guardados!";
        setTimeout(() => {
            if (saveButton) saveButton.textContent = originalText;
        }, 2000); 
    })
</script>
