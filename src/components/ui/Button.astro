---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
    variant?: "primary" | "secondary" | "danger";
};

const variants = {
    primary: "bg-white text-zinc-900 hover:bg-zinc-200",
    secondary: "border border-zinc-700 bg-zinc-800 text-white hover:bg-zinc-700",
    danger: "border border-red-900/50 bg-red-950/30 text-red-400 hover:bg-red-900/40",
};

const { variant = "primary", type = "button", class: className, ...rest } = Astro.props;
---

<button
    type={type}
    class:list={["rounded-lg px-4 py-2 font-medium transition-colors", variants[variant], className]}
    {...rest}
>
    <slot />
</button>
