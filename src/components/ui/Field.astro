---
interface Props {
    label: string;
    labelFor: string;
    hint?: string;
}

const { label, labelFor, hint } = Astro.props;
---

<div class="flex flex-col gap-2">
    <label for={labelFor} class="text-sm text-zinc-400">{label}</label>
    <slot />
    {hint && <span class="text-xs text-zinc-500">{hint}</span>}
</div>
