---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"select">;

const { class: className, ...rest } = Astro.props;
---

<select
    class:list={[
        "h-10 w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-white outline-none focus:border-zinc-500",
        className,
    ]}
    {...rest}
>
    <slot />
</select>
