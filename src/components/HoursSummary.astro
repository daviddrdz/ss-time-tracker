---
const { completed, remaining } = Astro.props;
---

<section class="mt-4">
    <h2 class="mb-3 text-xl font-bold">Horas</h2>

    <div class="grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
            <p class="text-sm text-zinc-400">Realizadas</p>
            <span class="text-4xl font-bold">{completed}</span>
        </div>

        <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
            <p class="text-sm text-zinc-400">Restantes</p>
            <span class="text-4xl font-bold">{remaining}</span>
        </div>
    </div>
</section>
