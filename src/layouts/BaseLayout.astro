---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
    title: string;
    heading: string;
    subtitle?: string;
}

const { title, heading, subtitle } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title}</title>
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="theme-color" content="#09090b" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <link rel="apple-touch-icon" href="/icon-192x192.png" />
    </head>

    <body class="min-h-screen bg-zinc-950 text-white pt-[env(safe-area-inset-top)]">
        <main class="mx-auto max-w-3xl p-6">
            <Nav />

            <div class="mb-8 mt-2 text-center">
                <h1 class="text-3xl font-bold tracking-tight">{heading}</h1>
                {subtitle && <p class="mt-2 text-zinc-400">{subtitle}</p>}
            </div>

            <slot />
        </main>
    </body>
</html>